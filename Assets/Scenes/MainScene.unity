  m_Script: {fileID: 11500000, guid: 24abebe619b470741b67ff2e75297801, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  innerThoughtsUI: {fileID: 2029976161}
  clientDialogueUI: {fileID: 2069995838}
  jurekArrivalDialogue:
  - speakerName: Jurek
    text: Good day, I'd like a shave...
    voiceSoundGroup: 
  - speakerName: Barber
    text: Right this way, please!
    voiceSoundGroup: 
  - speakerName: Jurek
    text: I parked my car outside, nobody is going to drive out of the yard, right?
    voiceSoundGroup: 
  - speakerName: Barber
    text: Not at all, sir! You can leave it there as long as you wish.
    voiceSoundGroup: 
  - speakerName: Jurek
    text: ...
    voiceSoundGroup: 
  jurekTimeoutComplaint: How much longer am I supposed to stand here?! If nobody's
    going to serve me, I'm taking my business elsewhere!
  jurekMouseScareReaction: Jesus Christ, a rat! In a barber shop?! I'm getting out
    of here right now!
