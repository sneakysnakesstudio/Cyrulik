--- !u!114 &1106172806
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1106172805}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 24abebe619b470741b67ff2e75297801, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  innerThoughtsUI: {fileID: 2029976161}
  clientDialogueUI: {fileID: 2069995838}
  jurekArrivalDialogue:
  - speakerName: Jurek
    text: Good day, I'd like a shave...
    voiceSoundGroup: 
  - speakerName: Barber
    text: Right this way, please!
    voiceSoundGroup: 
  - speakerName: Jurek
    text: I parked my car outside, nobody is going to drive out of the yard, right?
    voiceSoundGroup: 
  - speakerName: Barber
    text: Not at all, sir! You can leave it there as long as you wish.
    voiceSoundGroup: 
  - speakerName: Jurek
    text: ...
    voiceSoundGroup: 
  jurekWaterDialogue:
  - speakerName: Jurek
    text: Ah, finally... but my throat is completely dry.
    voiceSoundGroup: 
  - speakerName: Jurek
    text: Could you pour me a glass of water before we start?
    voiceSoundGroup: 
  - speakerName: Barber
    text: Of course, sir! Just a moment.
    voiceSoundGroup: 
  jurekThankForWaterDialogue:
  - speakerName: Jurek
    text: Ah, thank you! That hits the spot.
    voiceSoundGroup: 
  - speakerName: Jurek
    text: Alright, I'm ready. Let's get to work!
    voiceSoundGroup: 
  - speakerName: Barber
    text: Right away, sir.
    voiceSoundGroup: 
  jurekTimeoutComplaint: How much longer am I supposed to stand here?! If nobody's
    going to serve me, I'm taking my business elsewhere!
  jurekGloomyComplaint: It's pitch black and dead silent in here... The atmosphere
    is way too gloomy! I'm taking my business elsewhere!
  jurekMouseScareReaction: Jesus Christ, a rat! In a barber shop?! I'm getting out
    of here right now!
  jurekMouseCaughtReaction: Ohh my god mouse?! Take it out immediately!
